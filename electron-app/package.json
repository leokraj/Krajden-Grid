{
  "name": "krajden-grid-desktop",
  "version": "1.0.0",
  "description": "Desktop Companion for Krajden Grid - Transparent overlay",
  "author": "Krajden Grid",
  "repository": {
    "type": "git",
    "url": "https://github.com/leokraj/Krajden-Grid.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@opengsd/gsd-core": "github:open-gsd/gsd-core"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.krajden.grid",
    "electronVersion": "31.7.7",
    "productName": "KrajdenGrid",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "executableName": "KrajdenGrid",
    "copyright": "Copyright © 2026 Krajden Grid",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "publisherName": "Krajden Grid"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Krajden Grid",
      "runAfterFinish": true,
      "uninstallDisplayName": "Krajden Grid Uninstaller"
    }
  },
  "private": true
}
